# TypeScript emit (.js/.d.ts/.map) that lands beside sources when tsc runs on a
# program without an outDir; package builds emit into lib/, which is ignored above.
packages/**/src/**/*.js
packages/**/src/**/*.js.map
packages/**/src/**/*.d.ts
packages/**/src/**/*.d.ts.map
vendor/**/src/**/*.js
vendor/**/src/**/*.js.map
vendor/**/src/**/*.d.ts
vendor/**/src/**/*.d.ts.map
# Ambient declarations for untyped dependencies are hand-written, not emit.
!packages/**/src/**/css-modules.d.ts
!packages/**/src/**/ripgrep.d.ts
!packages/**/src/**/turndown-plugin-gfm.d.ts
!packages/**/src/**/use-sync-external-store.d.ts

# Delivery tools write one artifact per task id into the session cwd.
.dsh/changes/
.dsh/design/
openspec/changes/
